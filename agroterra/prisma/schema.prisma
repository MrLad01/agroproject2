// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider  = "postgresql"
}

// Define custom output path for generated Prisma Client
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma-client"
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  isAdmin       Boolean   @default(false) 
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MediaAsset {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String   // Stores the secure URL from Cloudinary
  publicId    String   // Useful for future deletions or transformations
  resourceType String   @default("image")
  createdAt   DateTime @default(now())
  heroSlides      HeroSlide[]
  sectionOneImages SectionOneImage[] 
}

// HOME PAGE

model HeroSlide {
  id        String   @id @default(uuid())
  order     Int      // controls carousel order
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id])
}

model HeroText {
  id       String @id @default(uuid())
  heading  String @default("WELCOME TO AGROTERRA")
  subtext  String @default("A place that celebrates life.")
}

model SectionOne {
  id         String           @id @default(uuid())
  label      String           @default("Agroterra Resort")
  heading    String           @default("WELCOME TO AGROTERRA")
  quote      String           @default("A place that celebrates life.")
  images     SectionOneImage[]
}

model SectionOneImage {
  id          String     @id @default(uuid())
  order       Int
  sectionId   String
  section     SectionOne @relation(fields: [sectionId], references: [id])
  assetId     String
  asset       MediaAsset @relation(fields: [assetId], references: [id])
}

model SectionTwo {
  id          String  @id @default(uuid())
  label       String  @default("Explore")
  heading     String  @default("A Place That Fits You")
  subheading  String  @default("Choose from spacious suites designed...")
  expLabel    String  @default("Experiences")        // experiences sub-section
  expHeading  String  @default("Harmony With Nature")
}
